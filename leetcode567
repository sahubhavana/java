class Solution {
    public boolean checkInclusion(String s1, String s2) {
      String x="";
      if(s2.contains(s1)){
        return true;
      }
        for(int i=0;i<s1.length();i++){
            x=x+s1.charAt(i);
           
            for(int j=0;j<s1.length();j++){
                x=x+s1.charAt(j);
                if(s2.contains(x)){
                    return true;
                }
            }
            x="";
            
        }
        return false;
    }
}
